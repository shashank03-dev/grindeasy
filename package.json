{
  "name": "grindeasy",
  "version": "0.3.1",
  "description": "Discord Rich Presence + personal tiers for AI coding tools (Claude Code, Codex, OpenCode). Shows what you're actively coding with, tracks your tier, and (Phase 2) feeds a global leaderboard.",
  "type": "module",
  "bin": {
    "grindeasy": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "discord",
    "rich-presence",
    "claude-code",
    "codex",
    "opencode",
    "ai-coding",
    "leaderboard"
  ],
  "author": "shashank",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
