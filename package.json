{
  "name": "grindeasy",
  "version": "0.9.0",
  "description": "Discord Rich Presence + personal tiers for AI coding tools. Auto-detects what you're actively coding with (Claude Code, Codex, OpenCode, Cursor, Gemini CLI, Aider, plus Zed, Continue, Copilot Chat, Cline and more), tracks your tier, and feeds a global leaderboard.",
  "type": "module",
  "bin": {
    "grindeasy": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "discord",
    "rich-presence",
    "claude-code",
    "codex",
    "opencode",
    "ai-coding",
    "leaderboard"
  ],
  "author": "shashank",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashank03-dev/grindeasy.git"
  },
  "bugs": {
    "url": "https://github.com/shashank03-dev/grindeasy/issues"
  },
  "homepage": "https://grindeasy.tech",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@xhayper/discord-rpc": "^1.3.4",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
